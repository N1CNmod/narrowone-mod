// ==UserScript==
// @name         Skin Presets Saver UI
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Export/Import skinPresets from IndexedDB with UI. use "+" to open menu
// @author       CNN
// @match        https://narrow.one/*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    let menu;

    // Access IndexedDB (keyValuesDb)
    const waitForDB = async () => {
        return new Promise((resolve, reject) => {
            const openReq = indexedDB.open("keyValuesDb");
            openReq.onsuccess = () => resolve(openReq.result);
            openReq.onerror = () => reject("❌ Failed to open keyValuesDb");
        });
    };

    // Get skinPresets object
    const getSkinPresets = async () => {
        const db = await waitForDB();
        return new Promise((resolve) => {
            const tx = db.transaction("keyValues", "readonly");
            const store = tx.objectStore("keyValues");
            const getReq = store.get("skinPresets");
            getReq.onsuccess = () => resolve(getReq.result || []);
        });
    };

    // Set/Replace skinPresets
    const saveSkinPresets = async (presets) => {
        const db = await waitForDB();
        return new Promise((resolve, reject) => {
            const tx = db.transaction("keyValues", "readwrite");
            const store = tx.objectStore("keyValues");
            const putReq = store.put(presets, "skinPresets");
            putReq.onsuccess = () => resolve();
            putReq.onerror = () => reject(putReq.error);
        });
    };

    // Download helper
    const downloadJSON = (data, filename) => {
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
    };

    // Upload helper
    const uploadJSON = () => {
        return new Promise((resolve) => {
            const input = document.createElement("input");
            input.type = "file";
            input.accept = ".json";
            input.onchange = () => {
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = () => {
                    try {
                        const json = JSON.parse(reader.result);
                        resolve(json);
                    } catch {
                        alert("❌ Invalid JSON file.");
                        resolve(null);
                    }
                };
                reader.readAsText(file);
            };
            input.click();
        });
    };

    const toggleMenu = () => {
        if (!menu) return;
        if (menu.style.display === "none" || menu.style.display === "") {
            menu.style.display = "block";

        } else {
            menu.style.display = "none";

        }
    };

    const createUI = () => {
        menu = document.createElement("div");
        Object.assign(menu.style, {
            position: 'fixed',
            top: '100px',
            left: '100px',
            width: '200px',
            backdropFilter: 'blur(15px)',
            backgroundColor: 'rgba(255, 255, 255, 0.8)',
            borderRadius: '18px',
            padding: '20px',
            color: '#1c1c1e',
            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif',
            fontSize: '14px',
            zIndex: 999999,
            boxShadow: '0 12px 30px rgba(0,0,0,0.2)',
            border: '1px solid rgba(0,0,0,0.1)',
            userSelect: 'none',
            cursor: 'grab',
            display: 'none'
        });

        menu.innerHTML = `
            <b style="display:flex; align-items:center; gap:8px; font-size:18px; margin-bottom:16px;">
              <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Objects/Bow%20and%20Arrow.png" alt="Bow and Arrow" width="25" height="25" />
              Skin Presets Saver
            </b>

            <button id="exportSkins" class="skin-btn" style="display:flex; align-items:center; gap:8px; padding: 8px 12px;">
              <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Symbols/Downwards%20Button.png" alt="Downwards Button" width="25" height="25" />
              Export Presets
            </button><br><br>

            <button id="importSkins" class="skin-btn" style="display:flex; align-items:center; gap:8px; padding: 8px 12px;">
              <img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Symbols/Upwards%20Button.png" alt="Upwards Button" width="25" height="25" />
              Import Presets
            </button><br><br>

            <small>N1 | CN</small>
        `;

        document.body.appendChild(menu);

        const style = document.createElement('style');
        style.textContent = `
          .skin-btn {
            width: 100%;
            background: #f0f0f5;
            border: 1px solid #d1d1d6;
            border-radius: 12px;
            font-size: 15px;
            color: #1c1c1e;
            font-weight: 600;
            box-shadow: 0 2px 5px rgba(0,0,0,0.08);
            transition: background-color 0.25s ease, box-shadow 0.25s ease;
            cursor: pointer;
            user-select: none;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            /* keep vertical height consistent */
            height: 42px;
          }
          .skin-btn:hover {
            background: #e5e5ea;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
          }
          .skin-btn:active {
            background: #d1d1d6;
          }
          small {
            color: #555;
            font-size: 12px;
          }
        `;
        document.head.appendChild(style);


        // Drag to move menu
        let isDragging = false, offsetX, offsetY;
        menu.addEventListener("mousedown", (e) => {
            isDragging = true;
            offsetX = e.clientX - menu.offsetLeft;
            offsetY = e.clientY - menu.offsetTop;
            menu.style.cursor = 'grabbing';
        });
        document.addEventListener("mouseup", () => {
            isDragging = false;
            menu.style.cursor = 'grab';
        });
        document.addEventListener("mousemove", (e) => {
            if (isDragging) {
                menu.style.left = `${e.clientX - offsetX}px`;
                menu.style.top = `${e.clientY - offsetY}px`;
            }
        });

        // Export
        document.getElementById("exportSkins").onclick = async () => {
            const presets = await getSkinPresets();
            if (!Array.isArray(presets) || presets.length === 0) {
                alert("⚠️ No skin presets to export.");
                return;
            }
            downloadJSON(presets, "skinPresetsBackup.json");
        };

        // Import
        document.getElementById("importSkins").onclick = async () => {
            const imported = await uploadJSON();
            if (!Array.isArray(imported)) return;

            await saveSkinPresets(imported);
            alert("✅ Skin presets imported.");
            location.reload();
        };
    };

    document.addEventListener('keydown', (e) => {
        if (e.key === '+') {
            toggleMenu();
        }
    });

    window.addEventListener("load", createUI);

})();
