// ==UserScript==
// @name         Narrow One - Map Version Selector
// @namespace    http://tampermonkey.net/
// @version      1.2
// @description  none
// @author       vyrin
// @match        *://narrow.one/*
// @match        *://*.narrow.one/*
// @match        *://poki.com/*
// @match        *://*.poki.com/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function() {
    'use strict';

    let bypassNextClick = false;

    window.__narrowOneMapsConfig = null;
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        const response = await originalFetch.apply(this, args);
        try {
            const url = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url ? args[0].url : '');
            if (url && url.includes('mapsConfig.json')) {
                const clone = response.clone();
                clone.json().then(data => {
                    window.__narrowOneMapsConfig = data;
                    console.log('[Mod] Maps config intercepted successfully.');
                }).catch(() => {});
            }
        } catch (e) {}
        return response;
    };

    const style = document.createElement('style');
    style.textContent = `
        .no-map-curtain {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5); z-index: 99999;
            display: flex; align-items: center; justify-content: center;
            animation: no-map-fade-in 0.2s ease-out;
        }
        @keyframes no-map-fade-in { from { opacity: 0; } to { opacity: 1; } }
        .no-map-dialog {
            position: relative; padding: 30px; box-sizing: border-box;
            width: max-content; max-width: 90vw;
            filter: drop-shadow(2px 2px 2px rgba(0,0,0,0.3));
            background: var(--default-ui-bg-color, white);
            background: paint(wrinkledPaper);
            --wrinkled-paper-color: var(--default-ui-bg-color, white);
            --wrinkled-paper-border-color: var(--default-wrinkled-paper-border-color, #353535);
            --wrinkled-paper-seed: 12345;
        }
        .no-map-title { margin: 0 0 20px 0; text-align: center; color: var(--default-text-color, black); }
        .no-map-text { font-family: sans-serif; margin-bottom: 20px; text-align: center; color: var(--default-text-color, black); font-size: 16px; }
        .no-map-btn-container { display: flex; flex-direction: column; gap: 10px; align-items: center; }
        .no-map-btn {
            padding: 7px 30px; height: auto; min-height: 38px;
            color: var(--default-text-color, black); border: none; appearance: none; cursor: pointer;
            background: var(--secondary-ui-bg-color, #e1e1e1);
            background: paint(wrinkledPaper);
            --wrinkled-paper-color: var(--secondary-ui-bg-color, #e1e1e1);
            --wrinkled-paper-border-color: var(--default-wrinkled-paper-border-color, #353535);
            --wrinkled-paper-seed: 54321;
            min-width: 280px; filter: drop-shadow(2px 2px 2px rgba(0,0,0,0.3));
            transition: filter 0.1s; display: flex; flex-direction: column; align-items: center; justify-content: center;
        }
        .no-map-btn:hover { filter: drop-shadow(2px 2px 2px rgba(0,0,0,0.3)) brightness(0.9); }
        .no-map-btn:active { filter: drop-shadow(2px 2px 2px rgba(0,0,0,0.3)) brightness(0.8); }
        .no-map-btn.cancel { --wrinkled-paper-color: #ffcccc; margin-top: 15px; font-size: 18px; }
        html.theme-dark .no-map-btn.cancel { --wrinkled-paper-color: #663333; color: #ffaaaa; }
        .no-map-btn.main-version { --wrinkled-paper-color: #ccffcc; }
        html.theme-dark .no-map-btn.main-version { --wrinkled-paper-color: #336633; color: #aaffaa; }
        .no-map-version-label { font-size: 12px; font-family: monospace; text-transform: none; font-weight: normal; line-height: 1.2em; margin-top: 5px; opacity: 0.7; }
    `;
    document.head.appendChild(style);

    document.addEventListener('click', (e) => {
        if (bypassNextClick) {
            bypassNextClick = false;
            return;
        }

        const btn = e.target.closest('.map-item-join-button');
        if (btn && window.__narrowOneMapsConfig) {
            const mapItem = btn.closest('.map-item');
            const titleEl = mapItem ? mapItem.querySelector('.map-item-title') : null;
            if (!titleEl) return;

            const mapName = titleEl.textContent.trim();
            const mapConfig = window.__narrowOneMapsConfig.maps.find(m => m.name === mapName);
            if (!mapConfig) return;

            const hashes = [mapConfig.hash];
            const altConfigs = [];

            if (mapConfig.alternativeMaps && mapConfig.alternativeMaps.length > 0) {
                for (const altAsset of mapConfig.alternativeMaps) {
                    const altConfig = window.__narrowOneMapsConfig.maps.find(m => m.assetName === altAsset);
                    if (altConfig && altConfig.hash) {
                        hashes.push(altConfig.hash);
                        altConfigs.push(altConfig);
                    }
                }
            }

            if (hashes.length > 1) {
                e.stopImmediatePropagation();
                e.preventDefault();
                showMapVersionSelector(mapConfig, hashes, altConfigs, btn);
            }
        }
    }, true);

    function formatAssetName(assetName) {
        if (!assetName) return "Alternative";
        return assetName.replace(/_/g, ' ').replace(/-/g, ' ');
    }

    function showMapVersionSelector(mapConfig, hashes, altConfigs, originalBtn) {
        const curtain = document.createElement('div');
        curtain.className = 'no-map-curtain';

        const dialog = document.createElement('div');
        dialog.className = 'no-map-dialog wrinkledPaper';
        dialog.style.setProperty('--wrinkled-paper-seed', Math.floor(Math.random() * 99999));

        const title = document.createElement('h2');
        title.className = 'no-map-title blueNight dialogTitle';
        title.textContent = 'Select Version';
        dialog.appendChild(title);

        const text = document.createElement('div');
        text.className = 'no-map-text';
        text.innerHTML = `Multiple versions found for <b>"${mapConfig.name}"</b>.`;
        dialog.appendChild(text);

        const btnContainer = document.createElement('div');
        btnContainer.className = 'no-map-btn-container';

        hashes.forEach((hash, idx) => {
            const btn = document.createElement('button');
            btn.className = 'no-map-btn wrinkledPaper blueNight';
            btn.style.setProperty('--wrinkled-paper-seed', Math.floor(Math.random() * 99999));

            let label = '';
            let subLabel = '';

            if (idx === 0) {
                label = 'Main Version';
                btn.classList.add('main-version');
                subLabel = mapConfig.assetName ? formatAssetName(mapConfig.assetName) : '';
            } else {
                const altCfg = altConfigs[idx - 1];
                label = altCfg.name || `Alternative ${idx}`;
                subLabel = altCfg.assetName ? formatAssetName(altCfg.assetName) : '';
                if (altCfg.label) label += ` (${altCfg.label})`;
            }

            const labelSpan = document.createElement('div');
            labelSpan.textContent = label;
            btn.appendChild(labelSpan);

            if (subLabel) {
                const subSpan = document.createElement('div');
                subSpan.className = 'no-map-version-label';
                subSpan.textContent = subLabel;
                btn.appendChild(subSpan);
            }

            btn.addEventListener('click', () => {
                curtain.remove();

                if (!originalBtn.isConnected) {
                    console.warn('[Mod] Join button no longer exists in DOM.');
                    return;
                }

                const targetRandom = (idx + 0.5) / hashes.length;
                const originalMathRandom = Math.random;
                Math.random = () => targetRandom;

                bypassNextClick = true;

                originalBtn.click();

                setTimeout(() => {
                    Math.random = originalMathRandom;
                }, 0);
            });

            btnContainer.appendChild(btn);
        });

        const cancelBtn = document.createElement('button');
        cancelBtn.className = 'no-map-btn cancel wrinkledPaper blueNight';
        cancelBtn.style.setProperty('--wrinkled-paper-seed', Math.floor(Math.random() * 99999));
        cancelBtn.textContent = 'Cancel';
        cancelBtn.addEventListener('click', () => curtain.remove());
        btnContainer.appendChild(cancelBtn);

        dialog.appendChild(btnContainer);
        curtain.appendChild(dialog);
        curtain.addEventListener('click', (e) => { if (e.target === curtain) curtain.remove(); });
        document.body.appendChild(curtain);
    }
})();
