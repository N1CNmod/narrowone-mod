// ==UserScript==
// @name         Keyboard + Mouse Visualizer
// @namespace    http://tampermonkey.net/
// @version      1.9
// @description  Shows WASD keyboard and mouse button visualization
// @author       parrol & CNN & Wurenjun
// @match        https://narrow.one/
// @grant        none
// @icon         https://i.imgur.com/YnUYnTm.png
// ==/UserScript==

(function() {
    'use strict';

    // ======================
    // Keyboard Visualizer
    // ======================
    let keyContainer = document.createElement("div");
    keyContainer.style.position = "fixed";
    keyContainer.style.bottom = "85px";
    keyContainer.style.right = "11px";
    keyContainer.style.display = "grid";
    keyContainer.style.gridTemplateColumns = "50px 50px 50px";
    keyContainer.style.gridTemplateRows = "50px 50px 50px";
    keyContainer.style.gap = "10px";
    keyContainer.style.textAlign = "center";
    keyContainer.style.backdropFilter = "blur(15px)";
    keyContainer.style.padding = "10px";
    keyContainer.style.borderRadius = "15px";
    keyContainer.style.border = "1px solid white";
    keyContainer.style.zIndex = "9999";
    document.body.appendChild(keyContainer);

    let keyElements = {};

    const keyPositions = {
        "Q": [1, 1], "W": [1, 2],
        "A": [2, 1], "S": [2, 2], "D": [2, 3],
        "Space": [3, 1, 3]
    };

    Object.keys(keyPositions).forEach(key => {
        let keyDiv = document.createElement("div");
        keyDiv.innerHTML = key === "Space" ? "SPACE" : key;
        keyDiv.style.padding = "15px";
        keyDiv.style.textAlign = "center";
        keyDiv.style.fontSize = "20px";
        keyDiv.style.background = "transparent";
        keyDiv.style.color = "white";
        keyDiv.style.backdropFilter = "blur(15px)";
        keyDiv.style.userSelect = "none";
        keyDiv.style.borderRadius = "15px";
        keyDiv.style.border = "1px solid white";

        keyDiv.style.gridColumn = keyPositions[key][1] + (key === "Space" ? " / span " + keyPositions[key][2] : "");
        keyDiv.style.gridRow = keyPositions[key][0];

        keyContainer.appendChild(keyDiv);
        keyElements[key] = keyDiv;
    });

    // ======================
    // Mouse Visualizer
    // ======================
    const mouse = document.createElement("div");
    mouse.style.width = "120px";
    mouse.style.height = "200px";
    mouse.style.border = "1px solid white";
    mouse.style.borderRadius = "10px";
    mouse.style.position = "fixed";
    mouse.style.bottom = "290px";
    mouse.style.right = "11px";
    mouse.style.display = "flex";
    mouse.style.flexDirection = "column";
    mouse.style.overflow = "hidden";
    mouse.style.background = "transparent";
    mouse.style.backdropFilter = "blur(15px)";
    mouse.style.zIndex = "9999";
    document.body.appendChild(mouse);

    const mouseTop = document.createElement("div");
    mouseTop.style.height = "50%";
    mouseTop.style.display = "flex";

    const leftHalf = document.createElement("div");
    leftHalf.style.flex = "1";
    leftHalf.style.borderRight = "1px solid white";
    leftHalf.style.background = "transparent";
    leftHalf.style.backdropFilter = "blur(15px)";

    const rightHalf = document.createElement("div");
    rightHalf.style.flex = "1";
    rightHalf.style.borderLeft = "1px solid white";
    rightHalf.style.background = "transparent";
    rightHalf.style.backdropFilter = "blur(15px)";

    mouseTop.appendChild(leftHalf);
    mouseTop.appendChild(rightHalf);
    mouse.appendChild(mouseTop);

    const mouseBottom = document.createElement("div");
    mouseBottom.style.height = "50%";
    mouseBottom.style.background = "transparent";
    mouseBottom.style.backdropFilter = "blur(15px)";
    mouse.appendChild(mouseBottom);

    // ======================
    // Event Listeners
    // ======================
    // Keyboard events
    document.addEventListener("keydown", function(event) {
        let keyPressed = event.code.replace("Key", "");
        if (keyElements[keyPressed]) {
            keyElements[keyPressed].style.background = "white";
            keyElements[keyPressed].style.color = "black";
        }
        if (event.code === "Space" && keyElements["Space"]) {
            keyElements[" Space"].style.background = "white";
            keyElements[" Space"].style.color = "black";
        }
    });

    document.addEventListener("keyup", function(event) {
        let keyReleased = event.code.replace("Key", "");
        if (keyElements[keyReleased]) {
            keyElements[keyReleased].style.background = "transparent";
            keyElements[keyReleased].style.color = "white";
        }
        if (event.code === "Space" && keyElements["Space"]) {
            keyElements[" Space"].style.background = "transparent";
            keyElements[" Space"].style.color = "white";
        }
    });

    // Mouse events
    document.addEventListener("mousedown", function(event) {
        if (event.button === 0) {
            leftHalf.style.background = "white";
        } else if (event.button === 2) {
            rightHalf.style.background = "white";
        }
    });

    document.addEventListener("mouseup", function(event) {
        if (event.button === 0) {
            leftHalf.style.background = "transparent";
        } else if (event.button === 2) {
            rightHalf.style.background = "transparent";
        }
    });

    document.addEventListener("contextmenu", function(e) {
        e.preventDefault();
    });
})();
