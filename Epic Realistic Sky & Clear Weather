// ==UserScript==
// @name         Narrow One - Epic Realistic Sky & Clear Weather
// @namespace    http://tampermonkey.net/
// @version      2.1
// @description  Combined realistic HDRI sky mod (Clear Day, Night Sky, Belfast Sunset) and forced clear weather. Press Ctrl+0 to switch skies! (Remembers your last choice)
// @description  [⚠️ For the sake of fairness, this mod should not be used in formal/official competitions ⚠️]
// @author       vyrin
// @match        *://narrow.one/*
// @match        *://www.narrow.one/*
// @match        *://*.narrow.one/*
// @match        *://game-cdn.poki.com/*
// @match        *://poki.com/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    const uniformLocations = new WeakMap();

    const weatherOverrides = {
        'fogAmount': 0.0,
        'fogHeightAmount': 0.0,
        'fogHeightAmountMin': 0.0,
        'fogHeightAmountMax': 0.0,
        'fogHeightDistFalloff': 0.0,
        'lightning': 0.0,
        'skyHighCol': [0.25, 0.55, 0.95],
        'skyMidCol': [0.55, 0.80, 1.00],
        'skyLowCol': [0.95, 0.95, 0.90],
        'colorMultiplier': [1.10, 1.05, 0.95],
        'colorAdder': [0.02, 0.02, 0.00],
        'saturation': 1.25
    };

    const skyOptions = [
        { name: '☀️ 晴天 (Clear Day)', url: 'https://dl.polyhaven.org/file/ph-assets/HDRIs/extra/Tonemapped%20JPG/kloofendal_48d_partly_cloudy_puresky.jpg' },
        { name: '🌃 璀璨夜空 (Night Sky)', url: 'https://dl.polyhaven.org/file/ph-assets/HDRIs/extra/Tonemapped%20JPG/dikhololo_night.jpg' },
        { name: '🌇 贝尔法斯特晚霞 (Belfast Sunset)', url: 'https://cdn.polyhaven.com/asset_img/primary/belfast_sunset_puresky.png?height=760&quality=95' },
        { name: '🌅 夸塔尼黄昏 (Quatani Sunset)', url: 'https://cdn.polyhaven.com/asset_img/primary/qwantani_dusk_2_puresky.png?height=760&quality=95' },
    ];

    // localStorage 键名
    const STORAGE_KEY = 'narrow_one_sky_index';

    // 获取保存的天空索引，如果没有则返回 0
    function getSavedSkyIndex() {
        try {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved !== null) {
                const index = parseInt(saved, 10);
                // 验证索引是否有效
                if (index >= 0 && index < skyOptions.length) {
                    return index;
                }
            }
        } catch (e) {
            console.warn('[EpicSky] 无法读取 localStorage:', e);
        }
        return 0;
    }

    // 保存天空索引到 localStorage
    function saveSkyIndex(index) {
        try {
            localStorage.setItem(STORAGE_KEY, index.toString());
        } catch (e) {
            console.warn('[EpicSky] 无法保存到 localStorage:', e);
        }
    }

    const hookGetUniformLocation = function(origFunc) {
        return function(program, name) {
            const loc = origFunc.call(this, program, name);
            if (loc) {
                if (!uniformLocations.has(this)) uniformLocations.set(this, new Map());
                uniformLocations.get(this).set(loc, name);
            }
            return loc;
        };
    };

    const hookUniformSetter = function(origFunc, funcName) {
        return function(location, ...args) {
            const ctxMap = uniformLocations.get(this);
            const name = ctxMap ? ctxMap.get(location) : null;
            if (name && weatherOverrides.hasOwnProperty(name)) {
                const overrideVal = weatherOverrides[name];
                try {
                    if (funcName === 'uniform1f' || funcName === 'uniform1i') return origFunc.call(this, location, overrideVal);
                    else if (funcName === 'uniform1fv' || funcName === 'uniform1iv') return origFunc.call(this, location, [overrideVal]);
                    else if (funcName === 'uniform3f') return origFunc.call(this, location, overrideVal[0], overrideVal[1], overrideVal[2]);
                    else if (funcName === 'uniform3fv') return origFunc.call(this, location, overrideVal);
                } catch (e) {}
            }
            return origFunc.call(this, location, ...args);
        };
    };

    const contexts = [
        typeof WebGLRenderingContext !== 'undefined' ? WebGLRenderingContext : null,
        typeof WebGL2RenderingContext !== 'undefined' ? WebGL2RenderingContext : null
    ];

    contexts.forEach(Ctx => {
        if (!Ctx) return;
        if (Ctx.prototype.getUniformLocation) Ctx.prototype.getUniformLocation = hookGetUniformLocation(Ctx.prototype.getUniformLocation);
        ['uniform1f', 'uniform1fv', 'uniform3f', 'uniform3fv'].forEach(funcName => {
            if (Ctx.prototype[funcName]) Ctx.prototype[funcName] = hookUniformSetter(Ctx.prototype[funcName], funcName);
        });
    });

    console.log('[Narrow One Mod] 🌤️ WebGL interceptor started. Locked to clear weather.');

    // 从 localStorage 恢复上次选择的天空
    let currentSkyIndex = getSavedSkyIndex();
    console.log(`[EpicSky] 📂 恢复上次选择的天空: ${skyOptions[currentSkyIndex].name}`);

    let skyMaterial = null;
    let skyTextureClass = null;
    let skyReplaced = false;

    const SKY_ROTATION = 0;

    function showNotification(text) {
        let notif = document.getElementById('epic-sky-notif');
        if (!notif) {
            notif = document.createElement('div');
            notif.id = 'epic-sky-notif';
            notif.style.cssText = `
                position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
                background: rgba(0, 0, 0, 0.8); color: white; padding: 12px 24px;
                border-radius: 8px; font-family: sans-serif; font-size: 18px; font-weight: bold;
                z-index: 99999; pointer-events: none; transition: opacity 0.5s;
                text-shadow: 0 2px 4px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2);
            `;
            document.body.appendChild(notif);
        }
        notif.textContent = text;
        notif.style.opacity = '1';
        clearTimeout(notif._timeout);
        notif._timeout = setTimeout(() => { notif.style.opacity = '0'; }, 2500);
    }

    window.addEventListener('keydown', (e) => {
        if (e.ctrlKey && (e.key === '0' || e.code === 'Digit0' || e.code === 'Numpad0')) {
            e.preventDefault();
            currentSkyIndex = (currentSkyIndex + 1) % skyOptions.length;
            const selectedSky = skyOptions[currentSkyIndex];
            console.log(`[EpicSky] 🔄 切换天空: ${selectedSky.name}`);

            saveSkyIndex(currentSkyIndex);

            showNotification(`🌌 天空已切换: ${selectedSky.name}`);
            loadAndApplySkyTexture(selectedSky.url);
        }
    });

    function loadAndApplySkyTexture(url) {
        if (!skyMaterial || !skyTextureClass) {
            console.warn('[EpicSky] 材质尚未初始化，等待...');
            return;
        }
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0);

            const texture = new skyTextureClass(canvas);
            texture.needsUpdate = true;
            skyMaterial.uniforms.skyTex.value = texture;
            console.log('[EpicSky] ✨ 天空贴图已更新!');
        };
        img.onerror = () => {
            console.error('[EpicSky] ❌ 图片加载失败 (可能由于跨域 CORS 限制):', url);
            showNotification('⚠️ 图片加载失败 (跨域限制)');
        };
        img.src = url;
    }

    const vertexShader = `
        varying vec3 vWorldDirection;
        void main() {
            vec4 worldPos = modelMatrix * vec4(position, 1.0);
            vWorldDirection = normalize(worldPos.xyz);
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            gl_Position.z = gl_Position.w;
        }
    `;

    const fragmentShader = `
        uniform sampler2D skyTex;
        uniform float rotation;
        varying vec3 vWorldDirection;
        const float PI = 3.141592653589793;
        void main() {
            vec3 dir = normalize(vWorldDirection);
            float u = 0.5 + atan(dir.z, dir.x) / (2.0 * PI) + rotation;
            float v = 1.0 - (0.5 - asin(clamp(dir.y, -1.0, 1.0)) / PI);
            u = mod(u, 1.0);
            vec4 texColor = texture2D(skyTex, vec2(u, v));
            vec3 linearColor = pow(texColor.rgb, vec3(2.2));
            gl_FragColor = vec4(linearColor, 1.0);
        }
    `;

    function applyRealisticSky(mo, skydome) {
        if (skyReplaced) return;
        skyReplaced = true;

        const ShaderMaterial = skydome.material.constructor;

        skyTextureClass = (() => {
            let TexClass = null;
            mo.scene.traverse(obj => {
                if (TexClass) return;
                const mat = Array.isArray(obj.material) ? obj.material[0] : obj.material;
                if (mat?.uniforms) {
                    Object.values(mat.uniforms).forEach(u => {
                        if (u?.value?.isTexture) TexClass = u.value.constructor;
                    });
                }
            });
            return TexClass;
        })();

        const rotRad = SKY_ROTATION / 360;
        skyMaterial = new ShaderMaterial({
            vertexShader,
            fragmentShader,
            uniforms: {
                skyTex:   { value: null },
                rotation: { value: rotRad },
            },
            side:       1,
            depthWrite: false,
        });

        skydome._originalMaterial = skydome.material;
        skydome.material = skyMaterial;
        skydome.scale.setScalar(450000);

        const savedSky = skyOptions[currentSkyIndex];
        loadAndApplySkyTexture(savedSky.url);
        showNotification(`🌌 史诗天空盒已激活 (按 Ctrl+0 切换) - 当前: ${savedSky.name}`);
        console.log('[EpicSky] 🌌 Epic realistic sky system initialized!');
    }

    const NativeWebSocket = window.WebSocket;
    window.WebSocket = class extends NativeWebSocket {
        constructor(...args) {
            super(...args);
            this.addEventListener('open', () => {
                setTimeout(() => {
                    if (window.capturedMo) return;
                    try {
                        const codeToInject = "window.capturedMo = main;";
                        const payload = JSON.stringify({ id: "cap", c: codeToInject });
                        const encoder = new TextEncoder();
                        const stringBytes = encoder.encode(payload);
                        const totalLength = 8 + stringBytes.length;
                        const paddedLength = Math.ceil(totalLength / 4) * 4;
                        const buffer = new ArrayBuffer(paddedLength);
                        const view32 = new Uint32Array(buffer, 0, 2);
                        view32[0] = 55;
                        view32[1] = stringBytes.length;
                        const u8 = new Uint8Array(buffer);
                        u8.set(stringBytes, 8);
                        this.dispatchEvent(new MessageEvent('message', { data: buffer }));
                    } catch (e) {
                        console.error('[EpicSky] WebSocket injection error:', e);
                    }
                }, 500);
            });
        }
    };

    function hookSceneAdd(mo) {
        if (!mo || !mo.scene || mo.scene.__skyHooked) return;
        mo.scene.__skyHooked = true;

        let existingSkydome = null;
        mo.scene.traverse(obj => { if (obj.name === 'skydome') existingSkydome = obj; });
        if (existingSkydome) {
            applyRealisticSky(mo, existingSkydome);
            return;
        }

        const originalAdd = mo.scene.add.bind(mo.scene);
        mo.scene.add = function(...args) {
            originalAdd(...args);
            if (skyReplaced) return;
            for (const obj of args) {
                if (obj && obj.name === 'skydome') {
                    applyRealisticSky(mo, obj);
                    break;
                }
            }
        };
    }

    let moInstance = null;
    Object.defineProperty(window, 'capturedMo', {
        get: function() { return moInstance; },
        set: function(val) {
            moInstance = val;
            if (val) {
                console.log('[EpicSky] 🎯 Game instance captured. Preparing scene hook...');
                hookSceneAdd(val);
            }
        },
        configurable: true
    });

    setInterval(() => {
        if (skyReplaced) return;
        if (window.capturedMo && window.capturedMo.scene) {
            hookSceneAdd(window.capturedMo);
        }
    }, 1000);

    console.log('[Narrow One Mod] 🚀 Combined Mod v2.1 loaded. Press Ctrl+0 to switch skies!');
})();
