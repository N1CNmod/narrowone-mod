// ==UserScript==
// @name         hair/eyebrow/beard Color Editor UI+
// @namespace    http://tampermonkey.net/
// @version      1
// @description  editing hair/eyebrow/beard colors from skin presets use "/" to open menu
// @author       CNN & Wurenjun
// @match        https://narrow.one/*
// @grant        none
// @icon         https://img.freepik.com/premium-vector/colour-wheel-with-colour-picker_854353-799.jpg
// ==/UserScript==


(function () {
    'use strict';

    let open = false;
    let presets = [];
    let db, objectStore;

    const menu = document.createElement('div');
    Object.assign(menu.style, {
        position: 'fixed',
        top: '100px',
        left: '100px',
        width: '300px',
        backdropFilter: 'blur(15px)',
        backgroundColor: 'rgba(255, 255, 255, 0.8)',
        borderRadius: '18px',
        padding: '20px',
        color: '#1c1c1e',
        fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif',
        fontSize: '14px',
        zIndex: 999999,
        boxShadow: '0 12px 30px rgba(0,0,0,0.2)',
        display: 'none',
        border: '1px solid rgba(0,0,0,0.1)',
        userSelect: 'none',
        cursor: 'grab',
    });

    menu.innerHTML = `
        <div style="font-size: 16px; font-weight: 600; margin-bottom: 16px;">🎨 Color Editor</div>

        <label style="display: block; margin-bottom: 6px;">Preset</label>
        <select id="presetSelector" style="width: 100%; padding: 8px; border-radius: 10px; border: 1px solid #ccc; margin-bottom: 16px; appearance: none;"></select>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
          <span style="font-weight: 500;">Hair Color</span>
          <input type="color" id="hairColor" style="border: none; width: 40px; height: 40px; border-radius: 50%; padding: 0; background: none; cursor: pointer;">
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
           <span style="font-weight: 500;">Eyebrow Color</span>
           <input type="color" id="eyebrowColor" style="border: none; width: 40px; height: 40px; border-radius: 50%; padding: 0; background: none; cursor: pointer;">
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
           <span style="font-weight: 500;">Beard Color</span>
           <input type="color" id="beardColor" style="border: none; width: 40px; height: 40px; border-radius: 50%; padding: 0; background: none; cursor: pointer;">
        </div>


        <button id="applyChanges" style="width: 100%; padding: 10px; background: #007aff; border: none; border-radius: 12px; color: white; font-weight: 500; cursor: pointer; transition: background 0.2s;">
            ✅ Apply & Refresh
        </button>
        <div style="margin-top: 18px; text-align: center; font-size: 12px; color: #888;">
          Made by <a href="https://discord.gg/zrWcRSJRJk" target="_blank" style="color: #007aff; text-decoration: none;"><strong>N1CN</strong></a> ❤️
        </div>

    `;
    document.body.appendChild(menu);

    let isDragging = false, offsetX, offsetY;
    menu.addEventListener('mousedown', (e) => {
        isDragging = true;
        offsetX = e.clientX - menu.getBoundingClientRect().left;
        offsetY = e.clientY - menu.getBoundingClientRect().top;
        menu.style.cursor = 'grabbing';
    });
    document.addEventListener('mouseup', () => {
        isDragging = false;
        menu.style.cursor = 'grab';
    });
    document.addEventListener('mousemove', (e) => {
        if (isDragging) {
            menu.style.left = `${e.clientX - offsetX}px`;
            menu.style.top = `${e.clientY - offsetY}px`;
        }
    });

    function rgbToHex([r, g, b]) {
        return "#" + [r, g, b].map(v => {
            let hex = Math.round(v * 255).toString(16);
            return hex.length === 1 ? "0" + hex : hex;
        }).join("");
    }

    function hexToRgb(hex) {
        hex = hex.replace("#", "");
        return [
            parseInt(hex.substring(0, 2), 16) / 255,
            parseInt(hex.substring(2, 4), 16) / 255,
            parseInt(hex.substring(4, 6), 16) / 255
        ];
    }

    function openDB() {
        const request = indexedDB.open("keyValuesDb");
        request.onsuccess = function (event) {
            db = event.target.result;
            const tx = db.transaction("keyValues", "readwrite");
            objectStore = tx.objectStore("keyValues");

            const getRequest = objectStore.get("skinPresets");
            getRequest.onsuccess = function () {
                const result = getRequest.result;
                if (Array.isArray(result)) {
                    presets = result;
                    updateUI();
                } else {
                    alert("skinPresets is not an array.");
                }
            };
        };
        request.onerror = () => alert("Could not open IndexedDB.");
    }

    function updateUI() {
        const selector = document.getElementById("presetSelector");
        selector.innerHTML = presets.map((_, i) => `<option value="${i}">Preset ${i + 1}</option>`).join("");
        selector.onchange = loadPreset;
        loadPreset();
    }

    function loadPreset() {
        const i = document.getElementById("presetSelector").value;
        const preset = presets[i];
        document.getElementById("hairColor").value = rgbToHex(preset.hairColorMultiplier);
        document.getElementById("eyebrowColor").value = rgbToHex(preset.eyebrowColorMultiplier);
        document.getElementById("beardColor").value = rgbToHex(preset.beardColorMultiplier);
    }

    document.getElementById("applyChanges").onclick = () => {
        const i = document.getElementById("presetSelector").value;
        presets[i].hairColorMultiplier = hexToRgb(document.getElementById("hairColor").value);
        presets[i].eyebrowColorMultiplier = hexToRgb(document.getElementById("eyebrowColor").value);
        presets[i].beardColorMultiplier = hexToRgb(document.getElementById("beardColor").value);

        const tx = db.transaction("keyValues", "readwrite");
        const store = tx.objectStore("keyValues");
        const putRequest = store.put(presets, "skinPresets");

        putRequest.onsuccess = () => location.reload();
        putRequest.onerror = () => alert("Save failed.");
    };

    document.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() === '/') {
            open = !open;
            menu.style.display = open ? 'block' : 'none';
            if (open && !db) openDB();
        }
    });
})();
