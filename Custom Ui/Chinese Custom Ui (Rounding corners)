(function() {
    'use strict';

GM_addStyle(`
    .dialog.wrinkledPaper,
    .chat-container,
    .health-ui-container,
    .dialog-button {
        position: fixed;
        border-radius: 20px; /* Bo góc */
        padding: 20px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(5px);
        border-image: linear-gradient(45deg, red, orange);
        overflow: visible; /* Đảm bảo không bị cắt nội dung bên trong */
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
    }

`);
})();


(function() {
    'use strict';

    GM_addStyle(`
        /* main page */
        div.buttonImage {
            box-shadow: 0 0 20px 10px #00ffd0, 0 0 30px 15px #00ffd0, rgba(0, 0, 255, 0.1);
        }
        .main-menu-username {
            color: #00ffd0;
        }
        .scoreOffsetNotificationAnim {
            color: #00ffa6;
            text-shadow: 0 0 10px #8327ab, 0 0 20px #6a138f, 0 0 30px #470663, 0 0 40px #470663;
        }
        }
        .scoreOffsetNotificationScore {
            color: #00ffd0;
        }
        .bottom-left-text {
            font-size: 2rem;
            position: fixed;
            border-radius: 25px; /* Bo góc */
            bottom: 9px;
            right: 9px;
            padding: 1.1rem;
            background-color: rgba(15, 15, 15, 0.4);
            color: #00ffa6;
        }
        div.dialog.dialogTitle {
            color: #7b49f5;
        }
        .main-menu-corner-profile .avatar {
            background-image: url(https://i.ibb.co/twSx3g1z/Logo-of-CN-2.png);
            background-size: cover;
            padding: 1.2rem;
            border: 5px solid #b69c09;
            border-radius: 50px;
}
    `);

    var bottomLeftText = document.createElement('div');
    bottomLeftText.className = 'bottom-left-text';
    bottomLeftText.textContent = 'N1CN ';
    document.body.appendChild(bottomLeftText);
})();


